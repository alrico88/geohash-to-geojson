{
  "name": "geohash-to-geojson",
  "version": "4.2.1",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "description": "Library to convert geohashes to multiple GeoJSON polygons or a single GeoJSON FeatureCollection",
  "repository": "https://github.com/alrico88/geohash-to-geojson",
  "author": "Alberto Rico",
  "license": "MIT",
  "dependencies": {
    "cheap-ruler": "^4.1.0",
    "ngeohash": "^0.6.3"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@rslib/core": "^0.23.1",
    "@turf/bbox": "^7.3.5",
    "@types/geojson": "^7946.0.7",
    "@types/ngeohash": "^0.6.2",
    "@vitest/coverage-v8": "^4.1.9",
    "coveralls": "^3.1.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "start": "pnpm run build -- --watch",
    "build": "rslib build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome check --write",
    "prepare": "pnpm run build",
    "docs": "typedoc",
    "coveralls": "vitest run --coverage && cat ./coverage/lcov.info | ./node_modules/coveralls/bin/coveralls.js"
  },
  "keywords": [
    "geojson",
    "geohash",
    "featurecollection",
    "convert",
    "polygon"
  ]
}
